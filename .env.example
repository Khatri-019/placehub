# ---------------------------------------------------------------------------
# PlaceHub Lite - LOCAL DEVELOPMENT ONLY. These values are NOT secrets.
# Copy to .env (cp .env.example .env). Never commit .env. Replace every value in any shared environment.
# ---------------------------------------------------------------------------

# HS256 signing secret shared by user-service (issuer) and every validating service. Min 32 bytes.
# Raw text, or prefix with "base64:" to supply Base64.
JWT_SECRET=change-me-local-dev-secret-at-least-32-bytes!!
JWT_TTL_MINUTES=60

# Shared secret for service-to-service /internal/** calls (header X-Internal-Token).
INTERNAL_SERVICE_TOKEN=change-me-local-internal-token

# The only browser origin allowed by gateway CORS.
FRONTEND_ORIGIN=http://localhost:5173

# User Service -> PostgreSQL (users-db)
USERS_DB_URL=jdbc:postgresql://users-db:5432/placehub_users
USERS_DB_USER=placehub_users
USERS_DB_PASSWORD=users_pw

# Job Service -> MySQL (jobs-db)
JOBS_DB_URL=jdbc:mysql://jobs-db:3306/placehub_jobs?allowPublicKeyRetrieval=true&useSSL=false
JOBS_DB_USER=placehub_jobs
JOBS_DB_PASSWORD=jobs_pw
JOBS_DB_ROOT_PASSWORD=jobs_root_pw

# Application Service -> PostgreSQL (applications-db)
APPLICATIONS_DB_URL=jdbc:postgresql://applications-db:5432/placehub_applications
APPLICATIONS_DB_USER=placehub_applications
APPLICATIONS_DB_PASSWORD=applications_pw

# Notification Service -> MongoDB (notifications-db)
NOTIFICATIONS_MONGO_USER=placehub_notifications
NOTIFICATIONS_MONGO_PASSWORD=notif_pw
NOTIFICATIONS_MONGO_URI=mongodb://placehub_notifications:notif_pw@notifications-db:27017/placehub_notifications?authSource=admin

# Kafka (internal listener inside the compose network)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Eureka
EUREKA_URL=http://discovery-server:8761/eureka

# Spring profile for all services (dev enables seed data)
SPRING_PROFILES_ACTIVE=dev

# Frontend build arg (baked into the static bundle at build time)
VITE_API_BASE_URL=http://localhost:8080

# Limit concurrent image builds to avoid OOM on 8 GB Docker hosts
COMPOSE_PARALLEL_LIMIT=2
